{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dombase-staging-backups",
  "account_id": "REPLACE_WITH_YOUR_ACCOUNT_ID",
  "main": "./backup/worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dombase-staging",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "dombase-staging-files"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "dombase-staging-backups"
    }
  ],
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true
  }
}
