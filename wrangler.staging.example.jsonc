{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dombase-staging",
  "account_id": "REPLACE_WITH_YOUR_ACCOUNT_ID",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dombase-staging",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "dombase-staging-files"
    }
  ],
  // Optional invitation email delivery: use an onboarded sender domain.
  // Keep actual deployment addresses in the ignored private configuration.
  "vars": {
    "INVITATION_EMAIL_FROM": "invites@example.com",
    "INVITATION_EMAIL_REPLY_TO": "ops@example.com",
    "INVITATION_EMAIL_ORIGIN": "https://your-staging.example.com"
  },
  "send_email": [{ "name": "INVITATION_EMAIL", "allowed_sender_addresses": ["invites@example.com"] }],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
