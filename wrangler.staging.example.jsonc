{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dombase-staging",
  "account_id": "REPLACE_WITH_YOUR_ACCOUNT_ID",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dombase-staging",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "dombase-staging-files"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
