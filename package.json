{
  "name": "dombase",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:staging": "DOMBASE_BUILD_TARGET=staging vinext build && node scripts/staging.mjs sanitize",
    "start": "vinext start",
    "test": "pnpm run build && node --test --test-concurrency=1 tests/rendered-html.test.mjs tests/schedule-enforcement.test.mjs tests/shift-builder.test.mjs tests/timesheets.test.mjs tests/local-db.test.mjs tests/auth.test.mjs tests/auth-app.test.mjs tests/access.test.mjs tests/access-app.test.mjs tests/account-lifecycle.test.mjs tests/self.test.mjs tests/self-schedule.test.mjs tests/self-app.test.mjs tests/self-schedule-app.test.mjs tests/team.test.mjs tests/invitation-email.test.mjs tests/team-app.test.mjs tests/team-p2.test.mjs tests/team-p2-app.test.mjs tests/kiosk.test.mjs tests/kiosk-ui.test.mjs tests/kiosk-app.test.mjs tests/workforce.test.mjs tests/review-regressions.test.mjs tests/manager-assignments.test.mjs tests/workforce-app.test.mjs tests/documents.test.mjs tests/documents-app.test.mjs tests/access-regressions.test.mjs tests/demo.test.mjs tests/backup.test.mjs tests/hosted-backup.test.mjs tests/backup-app.test.mjs tests/backup-alerts.test.mjs tests/offsite-backup.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/local-db.mjs migrate",
    "db:status:local": "node scripts/local-db.mjs status",
    "db:execute:local": "node scripts/local-db.mjs execute",
    "db:check:local": "node --test tests/local-db.test.mjs",
    "auth:configure:local": "node scripts/auth-local.mjs configure",
    "auth:invite:local": "node scripts/auth-local.mjs invite",
    "auth:invite:staging": "node scripts/auth-staging.mjs",
    "staging:inventory": "node scripts/staging.mjs inventory",
    "staging:status": "node scripts/staging.mjs status",
    "staging:migrate": "node scripts/staging.mjs migrate",
    "staging:deploy": "node scripts/staging.mjs deploy",
    "staging:secret": "node scripts/staging.mjs secret",
    "staging:check": "node scripts/staging-smoke.mjs",
    "staging:restore:check": "node scripts/verify-staging-restore.mjs",
    "staging:backup": "node scripts/staging.mjs backup",
    "kiosk:check:local": "node --test tests/kiosk.test.mjs",
    "workforce:check:local": "node --test tests/workforce.test.mjs",
    "documents:check:local": "node --test tests/documents.test.mjs",
    "storage:status:staging": "node scripts/storage-staging.mjs status",
    "storage:configure:staging": "node scripts/storage-staging.mjs configure",
    "access:check:local": "node --test --test-concurrency=1 tests/access.test.mjs tests/access-regressions.test.mjs",
    "staging:private-key": "node scripts/staging-private-key.mjs",
    "access:check:staging": "node scripts/verify-staging-permissions.mjs",
    "workforce:check:staging": "node scripts/verify-staging-workforce.mjs",
    "team:check:staging": "node scripts/verify-staging-team.mjs",
    "staging:schedule:check": "node scripts/verify-staging-schedule.mjs",
    "demo:seed:local": "node scripts/demo-local.mjs",
    "demo:seed:staging": "node scripts/demo-staging.mjs",
    "demo:check:local": "node --test tests/demo.test.mjs",
    "backup:configure:staging": "node scripts/backup-staging.mjs configure",
    "backup:deploy:staging": "node scripts/backup-staging.mjs deploy",
    "backup:status:staging": "node scripts/backup-staging.mjs status",
    "backup:offsite:check:staging": "node scripts/offsite-staging.mjs check",
    "backup:offsite:activate:staging": "node scripts/offsite-staging.mjs activate",
    "backup:offsite:verify:staging": "node scripts/backup-staging.mjs verify-offsite",
    "backup:verify:staging": "node scripts/backup-staging.mjs verify",
    "backup:create:local": "node scripts/backup-local.mjs create",
    "backup:daily:local": "node scripts/backup-local.mjs daily",
    "backup:verify:local": "node scripts/backup-local.mjs verify",
    "backup:check:local": "node --test tests/backup.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
