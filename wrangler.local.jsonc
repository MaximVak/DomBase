{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local development only. Remote setup will use Serge's actual account/DB IDs.
  "name": "dombase-local",
  "main": "./worker/index.ts",
  // Matches the installed workerd runtime; advance deliberately with upgrades.
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "dombase-local-files", "remote": false }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dombase-local",
      // Placeholder used only to identify the local emulator's database.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./drizzle",
      "remote": false
    }
  ]
}
